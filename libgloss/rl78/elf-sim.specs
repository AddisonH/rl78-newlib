%rename link_gcc_c_sequence sim_link_gcc_c_sequence

*sim_libgloss:
-lsim

*sim_libc:
%{!specs=nano.specs:-lc} %{specs=nano.specs:-lc_nano}

*link_gcc_c_sequence:
%(sim_link_gcc_c_sequence) --start-group %G %(sim_libc) %(sim_libgloss) --end-group

*startfile: 
--script rl78-sim.ld%s crt0%O%s crtbegin%O%s